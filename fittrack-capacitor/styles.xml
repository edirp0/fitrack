<?xml version="1.0" encoding="utf-8"?>
<!--
  QUESTO FILE va in: android/app/src/main/res/values/styles.xml
  Gestisce il tema dell'app e lo splash screen nativo
-->
<resources>

    <!-- Tema base — nasconde la action bar -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">#C8F53C</item>
        <item name="colorPrimaryDark">#06060E</item>
        <item name="colorAccent">#C8F53C</item>
        <item name="android:windowBackground">@color/background</item>
    </style>

    <!-- Tema splash — schermata nera mentre la WebView carica -->
    <!-- Rimuove il flash bianco all'avvio -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@color/background</item>
        <item name="windowSplashScreenBackground">@color/background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>

</resources>
